# Common Configuration
# Example: ms-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
BASE_API_KEY=your_api_key_here
# Example: https://api-inference.modelscope.cn/v1
BASE_BASE_URL=https://api-inference.modelscope.cn/v1

# OpenAI Compatible API Configuration (Chat & Summary)
OPENAI_API_KEY=${BASE_API_KEY}
OPENAI_BASE_URL=${BASE_BASE_URL}
CHAT_MODEL=ZhipuAI/GLM-5.1
SUMMARY_MODEL=Qwen/Qwen3.5-122B-A10B

# Embedding Configuration
EMBEDDING_API_KEY=${BASE_API_KEY}
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
EMBEDDING_CONTEXT_LEN=8000
# OPENAI_EMBEDDING_BASE_URL 优先级高于 QIANFAN_EMBEDDING_BASE_URL
OPENAI_EMBEDDING_BASE_URL=${BASE_BASE_URL}
# QIANFAN_EMBEDDING_BASE_URL=https://qianfan.baidubce.com/v2/embeddings

# Rerank Configuration
RERANK_API_KEY=${BASE_API_KEY}
RERANK_MODEL=qwen3-reranker-8b
# 根据需要启用对应的 Rerank 服务地址
# QIANFAN_RERANK_BASE_URL=https://qianfan.baidubce.com/v2/rerank
# DASHSCOPE_RERANK_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank

# Milvus Configuration
# MILVUS_URI 为空则使用本地文件 (milvus_local.db)
# MILVUS_URI=http://localhost:19530
MILVUS_DB_NAME=milvus_local.db
RETRIEVE_LIMIT=20
RERANK_LIMIT=8

# Processing Configuration
CHUNK_MAX_LENGTH=1000